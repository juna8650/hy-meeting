rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidReservation(data) {
      return data.spaceId is string
        && data.date is string
        && data.startTime is string
        && data.endTime is string
        && data.userName is string
        && data.purpose is string
        && data.passwordHash is string
        && data.status in ['confirmed', 'cancelled'];
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if isValidReservation(request.resource.data);
      allow update: if isValidReservation(request.resource.data);
      allow delete: if false;
    }

    match /blockedDates/{blockedId} {
      allow read: if true;
      allow write: if true;
    }

    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
